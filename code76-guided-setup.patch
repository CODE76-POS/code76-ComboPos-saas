+import { CODE76_MARKETING_CONTENT } from '../data/code76SiteContent.ts';
+
+/**
+ * CODE76 PRODUCT WEBSITE ONLY. Never source this content from a merchant's POS.
+ * Edit this file / LandingPage.tsx for the public pre-login CODE76 website.
+ * Merchant storefront settings remain in AppSettings.landingPage for compatibility.
+ * These are illustrative CODE76 catalogue/review fixtures, not a tenant's records.
+ */
+// Current CODE76 website copy. This is not a merchant preference or migration default.
+const CODE76_WEBSITE_SETTINGS = {
+  heroTitle: 'Transform Every Retail & Service Transaction into Predictable Profit',
+  heroSubtitle: 'Complete POS hardware, real-time inventory synchronization, automated debt tracking, and AI sales conversion for ambitious businesses.',
+  featuredCount: 6, slideshowSpeedMs: 4000, showSocialProof: true, showChatbot: true,
+  referralBonusText: 'Refer a fellow business owner or friend! When they purchase a terminal, both of you get $50 credit or 10% discount on next restock.',
+  topReferrersLimit: 5, showPromoCountdown: true, customInstagram: '@code76_pos', customTwitter: '@code76pos',
+  customWhatsappDirect: '+18007607676', shareableLinkSlogan: 'Exclusive Enterprise Commercial POS & ERP Hardware Special',
+};
+
+export const CODE76_SITE = Object.freeze({
+  company: Object.freeze({ ...CODE76_MARKETING_CONTENT.company }),
+  products: Object.freeze(CODE76_MARKETING_CONTENT.products.map(item => Object.freeze({ ...item }))),
+  reviews: Object.freeze(CODE76_MARKETING_CONTENT.reviews.map(review => Object.freeze({ ...review }))),
+  exampleSalesCount: CODE76_MARKETING_CONTENT.exampleSalesCount,
+  customers: Object.freeze(CODE76_MARKETING_CONTENT.customers.map(person => Object.freeze({ ...person }))),
+  marketingTeam: Object.freeze(CODE76_MARKETING_CONTENT.marketingTeam.map(person => Object.freeze({ ...person }))),
+  companyMembers: Object.freeze(CODE76_MARKETING_CONTENT.companyMembers.map(person => Object.freeze({ ...person }))),
+  landingPage: Object.freeze({ ...CODE76_WEBSITE_SETTINGS }),
+});
+
+export const CODE76_SITE_STORAGE_KEY = 'code76_public_site_v1';
diff --git a/src/context/Code76SiteContext.tsx b/src/context/Code76SiteContext.tsx
new file mode 100644
index 0000000..4deac5d
--- /dev/null
+++ b/src/context/Code76SiteContext.tsx
@@ -0,0 +1,45 @@
+import React, { createContext, useContext, useEffect, useState } from 'react';
+import type { LandingMetrics, PersonRecord } from '../types/index.ts';
+import { CODE76_SITE_STORAGE_KEY } from '../config/code76Site.ts';
+
+const ZERO_METRICS: LandingMetrics = { visitors: 0, avgTimeOnPageSeconds: 0, chatbotConversations: 0, leadsCaptured: 0, referralVisits: 0, totalLandingSales: 0 };
+type SiteLead = Omit<PersonRecord, 'id' | 'createdAt'> & { id: string; createdAt: string };
+interface SiteState {
+  metrics: LandingMetrics;
+  leads: SiteLead[];
+  events: { action: string; details: string; timestamp: string }[];
+}
+interface SiteContextValue extends SiteState {
+  setMetrics: React.Dispatch<React.SetStateAction<LandingMetrics>>;
+  addSiteLead: (lead: Omit<PersonRecord, 'id' | 'createdAt'>) => void;
+  logSiteEvent: (action: string, details: string) => void;
+}
+const SiteContext = createContext<SiteContextValue | null>(null);
+
+/** Separate browser-local product-site data. Never writes to the merchant CRM or metrics. */
+export function Code76SiteProvider({ children }: { children: React.ReactNode }) {
+  const [saved] = useState<Partial<SiteState>>(() => {
+    try { const value = JSON.parse(localStorage.getItem(CODE76_SITE_STORAGE_KEY) || '{}'); return value && typeof value === 'object' ? value : {}; } catch { return {}; }
+  });
+  const [metrics, setMetrics] = useState<LandingMetrics>({ ...ZERO_METRICS, ...saved.metrics });
+  const [leads, setLeads] = useState<SiteLead[]>(Array.isArray(saved.leads) ? saved.leads : []);
+  const [events, setEvents] = useState<SiteState['events']>(Array.isArray(saved.events) ? saved.events : []);
+  useEffect(() => {
+    try { localStorage.setItem(CODE76_SITE_STORAGE_KEY, JSON.stringify({ metrics, leads, events })); }
+    catch { console.warn('Unable to save CODE76 product-site data'); }
+  }, [metrics, leads, events]);
+
+  const addSiteLead: SiteContextValue['addSiteLead'] = lead => {
+    setLeads(previous => [{ ...lead, id: `site-lead-${crypto.randomUUID()}`, createdAt: new Date().toISOString() }, ...previous]);
+  };
+  const logSiteEvent: SiteContextValue['logSiteEvent'] = (action, details) => {
+    setEvents(previous => [{ action, details, timestamp: new Date().toISOString() }, ...previous].slice(0, 200));
+  };
+  return <SiteContext.Provider value={{ metrics, leads, events, setMetrics, addSiteLead, logSiteEvent }}>{children}</SiteContext.Provider>;
+}
+
+export function useCode76Site(): SiteContextValue {
+  const context = useContext(SiteContext);
+  if (!context) throw new Error('CODE76 site content must be inside Code76SiteProvider');
+  return context;
+}
