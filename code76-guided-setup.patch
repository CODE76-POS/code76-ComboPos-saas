+.setup-status { display: flex; align-items: flex-start; gap: 8px; border: 1px solid #14b8a64d; color: var(--pos-accent); padding: 10px 12px; border-radius: 10px; margin: 0 0 18px; font-size: .85em; line-height: 1.5; }
