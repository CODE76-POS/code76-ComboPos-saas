+/* POS preferences are deliberately scoped. Neither public landing page inherits them. */
+.pos-workspace { --pos-text-scale: 1; --pos-bg: #020617; --pos-panel: #0f172a; --pos-soft: #172239; --pos-line: #2a3950; --pos-ink: #edf4ff; --pos-muted: #9aadc3; --pos-accent: #5eead4; --pos-accent-soft: #113a39; }
+.pos-workspace[data-text-size="compact"] { --pos-text-scale: .9; }
+.pos-workspace[data-text-size="large"] { --pos-text-scale: 1.15; }
+.pos-workspace[data-text-size="xlarge"] { --pos-text-scale: 1.3; }
+.pos-workspace[data-pos-theme="light"] { --pos-bg: #f1f5f9; --pos-panel: #fff; --pos-soft: #f2f6f9; --pos-line: #d8e2e9; --pos-ink: #142b3a; --pos-muted: #516779; --pos-accent: #0d766e; --pos-accent-soft: #e7f7f2; }
+.pos-workspace :where(.text-xs):not([data-preserve-theme] *) { font-size: calc(.75rem * var(--pos-text-scale)); }
+.pos-workspace :where(.text-sm):not([data-preserve-theme] *) { font-size: calc(.875rem * var(--pos-text-scale)); }
+.pos-workspace :where(.text-base):not([data-preserve-theme] *) { font-size: calc(1rem * var(--pos-text-scale)); }
+.pos-workspace :where(.text-lg):not([data-preserve-theme] *) { font-size: calc(1.125rem * var(--pos-text-scale)); }
+.pos-workspace :where(.text-xl):not([data-preserve-theme] *) { font-size: calc(1.25rem * var(--pos-text-scale)); }
+.pos-workspace :where(.text-2xl):not([data-preserve-theme] *) { font-size: calc(1.5rem * var(--pos-text-scale)); }
+.pos-workspace :where(.text-3xl):not([data-preserve-theme] *) { font-size: calc(1.875rem * var(--pos-text-scale)); }
+.pos-workspace :where(.text-4xl):not([data-preserve-theme] *) { font-size: calc(2.25rem * var(--pos-text-scale)); }
+.pos-workspace [class~="text-[9px]"]:not([data-preserve-theme] *) { font-size: calc(9px * var(--pos-text-scale)); }
+.pos-workspace [class~="text-[10px]"]:not([data-preserve-theme] *) { font-size: calc(10px * var(--pos-text-scale)); }
+.pos-workspace [class~="text-[11px]"]:not([data-preserve-theme] *) { font-size: calc(11px * var(--pos-text-scale)); }
+.pos-workspace [class~="text-[12px]"]:not([data-preserve-theme] *) { font-size: calc(12px * var(--pos-text-scale)); }
+@media (min-width: 640px) {
+  .pos-workspace [class~="sm:text-xs"]:not([data-preserve-theme] *) { font-size: calc(.75rem * var(--pos-text-scale)); }
+  .pos-workspace [class~="sm:text-sm"]:not([data-preserve-theme] *) { font-size: calc(.875rem * var(--pos-text-scale)); }
+  .pos-workspace [class~="sm:text-lg"]:not([data-preserve-theme] *) { font-size: calc(1.125rem * var(--pos-text-scale)); }
+  .pos-workspace [class~="sm:text-xl"]:not([data-preserve-theme] *) { font-size: calc(1.25rem * var(--pos-text-scale)); }
+  .pos-workspace [class~="sm:text-2xl"]:not([data-preserve-theme] *) { font-size: calc(1.5rem * var(--pos-text-scale)); }
+  .pos-workspace [class~="sm:text-3xl"]:not([data-preserve-theme] *) { font-size: calc(1.875rem * var(--pos-text-scale)); }
+}
+/* Compatibility palette for existing POS utility-based screens; no marketing-site selectors. */
+.pos-workspace[data-pos-theme="light"] :where(.bg-slate-900, .bg-slate-800, [class*="bg-slate-900/"], [class*="bg-slate-800/"]):not([data-preserve-theme] *) { background-color: var(--pos-panel); }
+.pos-workspace[data-pos-theme="light"] :where(.bg-slate-950, .bg-slate-700, [class*="bg-slate-950/"]):not([data-preserve-theme] *) { background-color: var(--pos-soft); }
+.pos-workspace[data-pos-theme="light"] :where(.text-slate-50, .text-slate-100, .text-slate-200, .text-slate-300):not([data-preserve-theme] *) { color: var(--pos-ink); }
+.pos-workspace[data-pos-theme="light"] :where(.text-slate-400, .text-slate-500, .text-slate-600):not([data-preserve-theme] *) { color: var(--pos-muted); }
+.pos-workspace[data-pos-theme="light"] :where(.border-slate-700, .border-slate-800, .border-slate-600, [class*="border-slate-800/"], [class*="border-slate-700/"]):not([data-preserve-theme] *) { border-color: var(--pos-line); }
+.pos-workspace[data-pos-theme="light"] :where(h1, h2, h3, h4).text-white { color: var(--pos-ink); }
+.pos-workspace[data-pos-theme="light"] :where(.text-teal-300, .text-teal-400, .text-emerald-400):not([data-preserve-theme] *) { color: #0d766e; }
+.pos-workspace[data-pos-theme="light"] :where(.text-amber-300, .text-amber-400):not([data-preserve-theme] *) { color: #956000; }
+.pos-workspace[data-pos-theme="light"] :where(.text-sky-300, .text-sky-400):not([data-preserve-theme] *) { color: #036b98; }
+.pos-workspace[data-pos-theme="light"] :where(.text-purple-300, .text-purple-400):not([data-preserve-theme] *) { color: #7b37b3; }
+.pos-workspace :where(button, input, select, textarea, summary, a):focus-visible { outline: 2px solid #14b8a6; outline-offset: 3px; }
+
+.setup-backdrop { position: fixed; inset: 0; z-index: 999; display: flex; align-items: center; justify-content: center; padding: 20px; background: #020617bd; backdrop-filter: blur(8px); }
