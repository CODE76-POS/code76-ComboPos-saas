+.setup-progress small { font-size: .75em; font-weight: 600; }
+.setup-progress .is-current { color: var(--pos-ink); }
+.setup-progress .is-current > span, .setup-progress .is-done > span { background: var(--pos-accent); border-color: var(--pos-accent); color: var(--pos-panel); }
