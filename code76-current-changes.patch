@@ -0,0 +1,21 @@
+export function stopMediaStream(stream?: Pick<MediaStream,'getTracks'> | null): void { stream?.getTracks().forEach(track => track.stop()); }
+export function cameraErrorText(error: unknown): string {
+  const name = (error as {name?:string})?.name;
+  if (name === 'NotAllowedError' || name === 'PermissionDeniedError') return 'Camera permission was denied or blocked by this embedded preview. Allow camera access for the app in your browser. If the host blocks it, use the device-camera/file option below.';
+  if (name === 'NotFoundError' || name === 'DevicesNotFoundError') return 'No camera was found. Connect a camera or use the device-camera/file option.';
+  if (name === 'NotReadableError' || name === 'TrackStartError') return 'The camera is busy or unavailable. Close other apps using it, then retry.';
+  if (name === 'OverconstrainedError') return 'This camera cannot provide the requested mode. Try the other camera or upload a photo.';
+  return error instanceof Error ? error.message : 'The camera could not be opened. Retry or use a device photo.';
+}
+export function captureVideoFrame(video: Pick<HTMLVideoElement,'videoWidth'|'videoHeight'|'readyState'>, createCanvas = () => document.createElement('canvas')): string {
+  if (video.readyState < 2 || video.videoWidth <= 0 || video.videoHeight <= 0) throw new Error('Wait for the live camera image before taking a photo.');
+  const canvas = createCanvas();
+  const scale = Math.min(1, 1024 / Math.max(video.videoWidth,video.videoHeight));
+  canvas.width = Math.max(1,Math.round(video.videoWidth*scale)); canvas.height = Math.max(1,Math.round(video.videoHeight*scale));
+  const context = canvas.getContext('2d'); if (!context) throw new Error('This browser could not capture an image. Use a device photo instead.');
+  // Preview can be mirrored; saved product/document text remains readable.
+  context.drawImage(video as HTMLVideoElement,0,0,canvas.width,canvas.height);
+  const result = canvas.toDataURL('image/jpeg',0.85);
+  if (!result.startsWith('data:image/jpeg;base64,') || result.length < 100) throw new Error('The camera did not return a valid photo. Please retry.');
+  return result;
+}
diff --git a/src/utils/clipboard.ts b/src/utils/clipboard.ts
new file mode 100644
index 0000000..3629289
--- /dev/null
+++ b/src/utils/clipboard.ts
@@ -0,0 +1,59 @@
+export interface ClipboardAdapter {
+  write?: (text: string) => Promise<void>;
+  fallback?: (text: string) => boolean;
+}
+export interface CopyResult { ok: boolean; method: 'clipboard' | 'fallback' | 'manual' }
+
+function legacyCopy(text: string): boolean {
+  if (typeof document === 'undefined') return false;
+  const active = document.activeElement as HTMLElement | null;
+  const selection = document.getSelection();
+  const ranges = selection ? Array.from({ length: selection.rangeCount }, (_, index) => selection.getRangeAt(index).cloneRange()) : [];
+  const textarea = document.createElement('textarea');
+  textarea.value = text; textarea.readOnly = true; textarea.tabIndex = -1;
+  textarea.setAttribute('aria-hidden', 'true');
+  textarea.style.cssText = 'position:fixed;top:0;left:0;width:1px;height:1px;opacity:0;font-size:16px;';
+  const parent = document.querySelector('[role="dialog"][aria-modal="true"]') || document.body;
+  parent.appendChild(textarea);
+  try {
+    textarea.focus(); textarea.select(); textarea.setSelectionRange(0, text.length);
+    return document.execCommand('copy') === true;
+  } catch { return false; }
+  finally {
+    textarea.remove();
+    if (active?.isConnected) active.focus({ preventScroll: true });
+    if (selection) { selection.removeAllRanges(); ranges.forEach(range => { try { selection.addRange(range); } catch {} }); }
+  }
+}
+
+/** Await real success. Preview iframes may deny the modern API; try the legacy
+ * user-gesture path, then tell the UI to select visible text for manual copying.
+ * Never report "Copied" for an unavailable, rejected or false-returning API.
+ */
+export async function copyTextToClipboard(text: string, adapter?: ClipboardAdapter): Promise<CopyResult> {
+  if (!text) return { ok: false, method: 'manual' };
+  if (!adapter) {
+    let write: ClipboardAdapter['write'];
+    try {
+      if (typeof navigator !== 'undefined' && navigator.clipboard?.writeText) write = value => navigator.clipboard.writeText(value);
+    } catch {}
+    adapter = { write, fallback: legacyCopy };
+  }
+  if (adapter.write) {
+    try { await adapter.write(text); return { ok: true, method: 'clipboard' }; } catch {}
+  }
+  try { if (adapter.fallback?.(text) === true) return { ok: true, method: 'fallback' }; } catch {}
+  return { ok: false, method: 'manual' };
+}
+
+/** A link to this app, not a private merchant route or a URL containing tokens. */
+export function applicationUrl(href: string, basePath = '/'): string {
+  const current = new URL(href);
+  if (!['http:', 'https:'].includes(current.protocol)) throw new Error('An HTTP(S) application URL is required.');
+  const url = new URL(basePath.startsWith('/') && !basePath.startsWith('//') ? basePath : '/', current.origin);
+  url.username = ''; url.password = ''; url.search = ''; url.hash = '';
+  return url.href;
+}
+export function isWorkspacePreview(href: string): boolean {
+  try { return new URL(href).hostname.endsWith('.e2b.app'); } catch { return false; }
+}
