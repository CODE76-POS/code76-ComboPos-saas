diff --git a/src/utils/accessHistory.ts b/src/utils/accessHistory.ts
new file mode 100644
index 0000000..0c0a2b6
--- /dev/null
+++ b/src/utils/accessHistory.ts
@@ -0,0 +1,54 @@
+import { hasPlanFeature, planTier } from './plans.ts';
+import type { AppSettings, AuditLog, AuthUser } from '../types/index.ts';
+
+/** Match the app's existing union-of-active-roles policy. A UI unlock toggle,
+ * a master PIN, or membership of a named role alone cannot grant access.
+ */
+export function accessHistoryPermissions(user: AuthUser | null, settings: AppSettings) {
+  const paidAccess = hasPlanFeature(planTier(settings),'audit');
+  const granted = (key: 'canViewAuditLogs' | 'canExportPdf') => paidAccess && !!user && (user.isAdmin === true || user.roles.some(role => settings.privileges[role]?.[key] === true));
+  const canView = granted('canViewAuditLogs');
+  return { canView, canExport: canView && granted('canExportPdf') };
+}
+export function assertAccessHistoryExport(user: AuthUser | null, settings: AppSettings): void {
+  if (!accessHistoryPermissions(user, settings).canExport) throw new Error('Access-history export requires an administrator or both Audit Logs and Export Reports privileges.');
+}
+
+export const AUDIT_EXPORT_HEADERS = ['Log ID', 'Timestamp (ISO)', 'User', 'Role', 'Action', 'Details', 'Device / IP'] as const;
+export function auditExportRows(logs: readonly AuditLog[]): string[][] {
+  return logs.map(log => [log.id, log.timestamp, log.userName, log.userRole, log.action, log.details, log.ipOrDevice].map(value => String(value ?? '')));
+}
+/** Quote RFC 4180 cells, including newlines, and prevent spreadsheet formula execution. */
+export function safeCsvCell(value: string): string {
+  const safe = /^[\s\u0000-\u001f]*[=+\-@]/.test(value) || /^[\t\r\n]/.test(value) ? `'${value}` : value;
+  return `"${safe.replace(/"/g, '""')}"`;
+}
+export function accessHistoryCsv(logs: readonly AuditLog[]): string {
+  return '\uFEFF' + [AUDIT_EXPORT_HEADERS, ...auditExportRows(logs)].map(row => row.map(safeCsvCell).join(',')).join('\r\n') + '\r\n';
+}
+export function accessHistoryText(logs: readonly AuditLog[], officer: string, generatedAt = new Date().toISOString()): string {
+  const header = `CODE76 POS — User access history\nGenerated: ${generatedAt}\nExported by: ${JSON.stringify(officer)}\nFiltered records: ${logs.length}\nBrowser-local activity records; not a tamper-proof server audit.\n`;
+  return header + auditExportRows(logs).map((row, index) => `\n--- Record ${index + 1} ---\n` + AUDIT_EXPORT_HEADERS.map((label, i) => `${label}: ${JSON.stringify(row[i])}`).join('\n')).join('\n') + '\n';
+}
+
+export function downloadReport(data: BlobPart, mime: string, filename: string): void {
+  const url = URL.createObjectURL(new Blob([data], { type: mime }));
+  const anchor = document.createElement('a'); anchor.href = url; anchor.download = filename;
+  document.body.appendChild(anchor); anchor.click(); anchor.remove();
+  // Do not revoke immediately: browsers may still be reading the object URL.
+  setTimeout(() => URL.revokeObjectURL(url), 30_000);
+}
+
+/** Full JSON backups must not become a parallel access-history export bypass. */
+export function permittedBackup(serialized: string, user: AuthUser | null, settings: AppSettings): string {
+  const state = JSON.parse(serialized);
+  if (!state || typeof state !== 'object' || Array.isArray(state)) throw new Error('The saved backup is not a valid POS object.');
+  if (!accessHistoryPermissions(user, settings).canExport) delete state.auditLogs;
+  const canAdminister = user && (user.isAdmin || user.roles.some(role=>settings.privileges[role]?.canModifySettings));
+  if(!canAdminister)delete state.teamServiceBriefs;
+  const canManage = user && (user.isAdmin || user.roles.some(role=>settings.privileges[role]?.canManagePeople));
+  if (!canManage) { delete state.salaryPayments; for (const key of ['customers','vendors','transporters','marketingTeam','companyMembers','relatedCompanies']) if(Array.isArray(state[key])) state[key]=state[key].map(({salaryRate,salaryBasis,...record}:Record<string,unknown>)=>record); }
+  const canViewExpenses = user && (user.isAdmin || user.roles.some(role=>settings.privileges[role]?.canViewExpenses));
+  if(!canManage && !canViewExpenses && Array.isArray(state.expenses)) state.expenses=state.expenses.filter((expense:{category?:string;salaryPaymentId?:string})=>expense.category!=='Salaries'&&!expense.salaryPaymentId);
+  return JSON.stringify(state, null, 2);
+}
diff --git a/src/utils/accessHistoryPdf.ts b/src/utils/accessHistoryPdf.ts
new file mode 100644
index 0000000..ae6ba5c
--- /dev/null
+++ b/src/utils/accessHistoryPdf.ts
@@ -0,0 +1,55 @@
+import type { AuditLog } from '../types/index.ts';
+import { AUDIT_EXPORT_HEADERS, auditExportRows } from './accessHistory.ts';
+
+let fontPromise: Promise<string> | undefined;
+async function loadFont(): Promise<string> {
+  if (!fontPromise) fontPromise = (async () => {
+    const base = import.meta.env?.BASE_URL || '/';
+    const response = await fetch(`${base}fonts/audit-sans.ttf`);
+    if (!response.ok) throw new Error('The local PDF font could not be loaded. Please retry or export TXT/CSV.');
+    const bytes = new Uint8Array(await response.arrayBuffer());
+    let binary = '';
+    for (let index = 0; index < bytes.length; index += 0x8000) binary += String.fromCharCode(...bytes.subarray(index, index + 0x8000));
+    return btoa(binary);
+  })().catch(error => { fontPromise = undefined; throw error; });
+  return fontPromise;
+}
+
+/** Lazy-load PDF code/font only when an authorized export is requested. Plain
+ * text, never HTML, is used for records. Embedded Unicode font + real pagination.
+ */
+export async function accessHistoryPdf(logs: readonly AuditLog[], officer: string, fontBase64?: string): Promise<Uint8Array> {
+  const [{ jsPDF }, font] = await Promise.all([import('jspdf'), fontBase64 ? Promise.resolve(fontBase64) : loadFont()]);
+  const doc = new jsPDF({ compress: true, putOnlyUsedFonts: true });
+  doc.addFileToVFS('AuditSans.ttf', font); doc.addFont('AuditSans.ttf', 'AuditSans', 'normal'); doc.setFont('AuditSans');
+  doc.setProperties({ title: 'CODE76 POS - User access history', author: 'CODE76 POS', subject: 'Filtered browser-local activity export' });
+  const margin = 15, width = 180, bottom = 278;
+  let y = 20;
+  const line = (text: string, size = 9, color = '#0f172a') => {
+    doc.setFontSize(size); doc.setTextColor(color);
+    const clean = text.replace(/[\u0000-\u0008\u000b\u000c\u000e-\u001f]/g, '');
+    const wrapped = doc.splitTextToSize(clean || ' ', width) as string[];
+    for (const part of wrapped) {
+      if (y + size * 0.45 > bottom) { doc.addPage(); y = 20; }
+      doc.text(part, margin, y); y += size * 0.45 + 1.1;
+    }
+  };
+  line('CODE76 POS - User access history', 16, '#0f766e'); y += 2;
+  line(`Generated: ${new Date().toISOString()}`);
+  line(`Exported by: ${officer}`);
+  line(`Filtered records: ${logs.length}`);
+  line('Browser-local activity records; not a tamper-proof server audit.', 8, '#64748b'); y += 4;
+  auditExportRows(logs).forEach((row, index) => {
+    if (y > 240) { doc.addPage(); y = 20; }
+    line(`Record ${index + 1}`, 11, '#0f766e');
+    AUDIT_EXPORT_HEADERS.forEach((header, i) => line(`${header}: ${row[i]}`));
+    y += 5;
+  });
+  if (!logs.length) line('No records match the selected filters.');
+  const pages = doc.getNumberOfPages();
+  for (let page = 1; page <= pages; page++) {
+    doc.setPage(page); doc.setFontSize(8); doc.setTextColor('#64748b');
+    doc.text(`Page ${page} of ${pages}`, margin, 289);
+  }
+  return new Uint8Array(doc.output('arraybuffer'));
+}
diff --git a/src/utils/appRouting.ts b/src/utils/appRouting.ts
new file mode 100644
index 0000000..e58118b
--- /dev/null
+++ b/src/utils/appRouting.ts
@@ -0,0 +1,36 @@
+import type { PlatformId } from '../types/index.ts';
+
+export type AppView = 'landing' | 'pos';
+export interface AppRoute { view: AppView; platform: PlatformId }
+
+export const PLATFORM_IDS: readonly PlatformId[] = [
+  'selling', 'sales_history', 'inventory', 'expenses', 'invoices', 'analytics',
+  'customers', 'vendors', 'transporters', 'marketing_team', 'company_members',
+  'my_company', 'messaging', 'landing_page_builder', 'settings', 'audit_logs', 'about',
+];
+
+/** The base URL is ALWAYS public, regardless of the current authentication state.
+ * Only explicit /pos hashes request an internal screen. Legacy ?view=storefront
+ * and ordinary marketing section anchors cannot select a merchant page.
+ */
+export function parseAppRoute(hash: string): AppRoute {
+  const path = hash.replace(/^#/, '').split('?')[0].replace(/\/+$/, '');
+  if (path === '/pos') return { view: 'pos', platform: 'selling' };
+  const platform = /^\/pos\/([^/]+)$/.exec(path)?.[1] as PlatformId | undefined;
+  if (platform && PLATFORM_IDS.includes(platform)) return { view: 'pos', platform };
+  return { view: 'landing', platform: 'selling' };
+}
+
+/** This is an application rendering guard, not server-side authentication. */
+export function resolveAppSurface(route: AppRoute, authenticated: boolean): 'code76' | 'pos' | 'business' {
+  if (route.view !== 'pos' || !authenticated) return 'code76';
+  return route.platform === 'landing_page_builder' ? 'business' : 'pos';
+}
+
+/** Keep deployment paths and unrelated parameters; never generate a public storefront URL. */
+export function viewUrl(view: AppView, href: string, platform: PlatformId = 'selling'): string {
+  const url = new URL(href);
+  url.searchParams.delete('view');
+  url.hash = view === 'pos' ? `/pos${platform === 'selling' ? '' : `/${platform}`}` : '';
+  return url.toString();
+}
