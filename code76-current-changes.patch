diff --git a/src/components/landing/LandingSectionNav.tsx b/src/components/landing/LandingSectionNav.tsx
new file mode 100644
index 0000000..6f2c73d
--- /dev/null
+++ b/src/components/landing/LandingSectionNav.tsx
@@ -0,0 +1,7 @@
+import React,{useEffect,useRef,useState} from 'react';
+export interface LandingSection {id:string;label:string}
+export function LandingSectionNav({sections,label,preserveHash=false}:{sections:LandingSection[];label:string;preserveHash?:boolean}){
+ const [active,setActive]=useState(sections[0]?.id||'');const nav=useRef<HTMLElement>(null);const ids=sections.map(s=>s.id).join('|');
+ useEffect(()=>{const targets=sections.map(section=>document.getElementById(section.id)).filter(Boolean) as HTMLElement[];if(!targets.length)return;const observer=new IntersectionObserver(entries=>{const visible=entries.filter(entry=>entry.isIntersecting).sort((a,b)=>a.boundingClientRect.top-b.boundingClientRect.top);if(visible[0])setActive(visible[0].target.id);},{rootMargin:'-18% 0px -45% 0px',threshold:0});targets.forEach(target=>observer.observe(target));return()=>observer.disconnect();},[ids]);
+ return <nav ref={nav} aria-label={label} className="border-b border-slate-800 bg-slate-950/95"><div className="max-w-7xl mx-auto px-3 sm:px-6 flex items-center gap-1 overflow-x-auto py-2" style={{scrollbarWidth:'thin'}}>{sections.map(section=><a key={section.id} href={`#${section.id}`} aria-current={active===section.id?'location':undefined} className={`shrink-0 rounded-lg px-3 py-2 text-xs font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-teal-400 ${active===section.id?'bg-teal-700 text-white':'text-slate-300 hover:bg-slate-800 hover:text-white'}`} onClick={event=>{setActive(section.id);if(preserveHash){event.preventDefault();document.getElementById(section.id)?.scrollIntoView({behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'start'});}}}>{section.label}</a>)}</div></nav>;
+}
