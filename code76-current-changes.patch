+import React,{useState} from 'react';
+import { referralCoefficient,paybackMonths,lifetimeValueRatio,orderValueFactor,netRetention,weightedEngagement } from '../../utils/growthMath.ts';
+const tools={
+ referrals:{label:'Referral loop',fields:[['Invitations per customer',3],['Invite conversion (%)',20]],formula:'K = invitations × conversion rate',run:(v:number[])=>referralCoefficient(v[0],v[1]),unit:'new customers per existing customer'},
+ payback:{label:'Acquisition payback',fields:[['Acquisition cost per customer',100],['Monthly gross profit per customer',25]],formula:'Payback = acquisition cost ÷ monthly gross profit',run:(v:number[])=>paybackMonths(v[0],v[1]),unit:'months to recoup acquisition cost'},
+ value:{label:'LTV : CAC',fields:[['Monthly revenue per customer',40],['Gross margin (%)',50],['Retention assumption (months)',12],['Acquisition cost per customer',100]],formula:'LTV : CAC = (monthly revenue × margin × retention months) ÷ acquisition cost',run:(v:number[])=>lifetimeValueRatio(v[0],v[1],v[2],v[3]),unit:'estimated gross lifetime value per acquisition-cost unit'},
+ bundle:{label:'Order-value comparison',fields:[['Base checkout revenue',100],['Checkout revenue with an optional bundle',120]],formula:'AOV factor = bundle checkout revenue ÷ base checkout revenue',run:(v:number[])=>orderValueFactor(v[0],v[1]),unit:'× base order value'},
+ retention:{label:'Net revenue retention',fields:[['Starting monthly recurring revenue',1000],['Expansion revenue',100],['Churned revenue',50]],formula:'NRR = (starting MRR + expansion − churn) ÷ starting MRR',run:(v:number[])=>netRetention(v[0],v[1],v[2]),unit:'× starting recurring revenue'},
+ engagement:{label:'Weighted engagement',fields:[['Bookmarks',10],['Comments',10],['Shares',10],['Impressions',1000]],formula:'Weighted engagement = (3 × bookmarks + 2 × comments + shares) ÷ impressions',run:(v:number[])=>weightedEngagement(v[0],v[1],v[2],v[3]),unit:'weighted actions per impression (not a universal platform algorithm)'},
+} as const;
+type Tool=keyof typeof tools;
+export function GrowthPlanner(){
+ const [tool,setTool]=useState<Tool>('payback');const [values,setValues]=useState<number[]>(tools.payback.fields.map(field=>field[1]));
+ const selected=tools[tool];let result:number|null=null,error='';try{result=selected.run(values);}catch(value){error=value instanceof Error?value.message:'Check inputs.';}
+ return <section id="growth-planner" className="max-w-7xl mx-auto px-4 py-12"><div className="rounded-3xl border border-teal-900 bg-gradient-to-br from-slate-900 to-teal-950/30 p-5 sm:p-8"><div className="grid lg:grid-cols-2 gap-7"><div><span className="text-xs font-bold uppercase tracking-widest text-teal-400">Make the next decision clearer</span><h2 className="mt-2 text-2xl sm:text-3xl font-black">Test the numbers before you commit</h2><p className="mt-4 text-sm leading-relaxed text-slate-400">Explore acquisition, retention, order value and referral assumptions with simple, visible arithmetic. Adjust the example inputs to your business—nothing here predicts or guarantees your results.</p><p className="mt-4 text-xs text-slate-500">Inspired by the supplied economic equations. LTV includes an explicit retention horizon; a monthly profit figure alone is not lifetime value. Example inputs are hypothetical, not CODE76 customer performance.</p><a href="#plans" className="mt-5 inline-flex text-sm font-bold text-teal-300 underline">Compare plans with the same clarity</a></div><div className="rounded-2xl border border-slate-700 bg-slate-950 p-4"><label className="block text-xs font-semibold text-slate-300">Planning tool<select aria-label="Growth planning tool" className="mt-2 w-full rounded-xl border border-slate-700 bg-slate-900 px-3 py-2 text-sm" value={tool} onChange={event=>{const next=event.target.value as Tool;setTool(next);setValues(tools[next].fields.map(field=>field[1]));}}>{Object.entries(tools).map(([id,tool])=><option key={id} value={id}>{tool.label}</option>)}</select></label><div className="mt-4 grid sm:grid-cols-2 gap-3">{selected.fields.map(([label],index)=><label className="text-xs text-slate-400" key={label}>{label}<input aria-label={label} type="number" min="0" step="any" className="mt-1 w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-100" value={values[index]??''} onChange={event=>setValues(old=>old.map((v,i)=>i===index?Number(event.target.value):v))}/></label>)}</div><p className="mt-4 text-[11px] text-slate-500">{selected.formula}</p><div role="status" aria-live="polite" className="mt-4 rounded-xl border border-teal-800 p-4"><strong className="text-3xl text-teal-300">{error?'Check inputs':result===null?'Not defined':new Intl.NumberFormat('en',{maximumFractionDigits:2}).format(result)}</strong><p className="mt-1 text-xs text-slate-400">{error|| (result===null?'Use a positive denominator to calculate this scenario.':selected.unit)}</p></div><p className="mt-3 text-[10px] text-slate-500">Local calculator only. No input is sent or saved, and no ROI, ranking or sales guarantee is made.</p></div></div></div></section>;
+}
