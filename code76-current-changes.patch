@@ -0,0 +1,62 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {PLAN_PRICING,planCost,usd} from '../../src/config/planPricing.ts';
+import {PLAN_INFO,PLAN_TIERS,FEATURES,hasPlanFeature,canOpenSettings,planTier} from '../../src/utils/plans.ts';
+import {TEAM_SERVICES,TEAM_SERVICE_SCOPE} from '../../src/config/teamServices.ts';
+import {referralCoefficient,paybackMonths,lifetimeValueRatio,orderValueFactor,netRetention,weightedEngagement} from '../../src/utils/growthMath.ts';
+import {softwarePlanReply,code76SiteReply} from '../../src/utils/code76Offers.ts';
+import {salesProjection} from '../../src/utils/salesProjection.ts';
+import {INITIAL_SETTINGS} from '../../src/data/initialData.ts';
+import type {PlanTier,SaleTransaction,AppSettings} from '../../src/types/index.ts';
+const source=(path:string)=>readFileSync(new URL(`../../${path}`,import.meta.url),'utf8');
+const expected:Record<PlanTier,[number,number,string]>={free:[20,0,'month'],starter:[26,13,'month'],pro:[50,25,'month'],max:[110,55,'month'],lifetime:[500,250,'once']};
+for(const tier of PLAN_TIERS){
+ test(`${tier} has the confirmed USD standard/promotional prices and cadence`,()=>{const [list,current,interval]=expected[tier];assert.equal(PLAN_PRICING[tier].list,list);assert.equal(PLAN_PRICING[tier].current,current);assert.equal(PLAN_PRICING[tier].interval,interval);});
+ test(`${tier} discount is transparent and mathematically correct`,()=>{const p=PLAN_PRICING[tier];assert.equal(p.current,p.list*(1-p.discountPercent/100));assert.equal(p.discountPercent,tier==='free'?100:50);});
+ test(`${tier} illustrative multi-month cost treats Lifetime as one-time`,()=>assert.equal(planCost(tier,12),PLAN_PRICING[tier].current*(tier==='lifetime'?1:12)));
+}
+test('all five plans have unique IDs and Max is a first-class persisted plan',()=>{assert.deepEqual(PLAN_TIERS,['free','starter','pro','max','lifetime']);assert.equal(planTier({...INITIAL_SETTINGS,planTier:'max'}),'max');});
+test('comparison months reject fractional, zero and infinite values',()=>{for(const n of [0,-1,1.2,Infinity,NaN])assert.throws(()=>planCost('max',n));});
+test('displayed subscription prices are USD, never merchant inventory currency',()=>{assert.ok(usd(55).includes('$55'));const price=source('src/components/common/PlanPrice.tsx');assert.ok(price.includes('USD'));assert.ok(price.includes('<del'));assert.ok(!price.includes('company.currency'));});
+test('no artificial offer expiry or configured billing is invented by the price cards',()=>{const page=source('src/components/landing/PlanOverview.tsx');assert.ok(page.includes('No artificial deadline/countdown'));assert.ok(page.includes('Billing remains disconnected'));});
+for(const tier of PLAN_TIERS)test(`${tier} gets team service access only when Max or Lifetime`,()=>assert.equal(hasPlanFeature(tier,'team_services'),tier==='max'||tier==='lifetime'));
+test('Max includes every Pro software feature plus the team package',()=>{for(const feature of FEATURES)if(hasPlanFeature('pro',feature))assert.equal(hasPlanFeature('max',feature),true);assert.equal(hasPlanFeature('max','team_services'),true);});
+test('Lifetime includes both future/current software capability and Max service access',()=>{for(const feature of FEATURES)assert.equal(hasPlanFeature('lifetime',feature),true);assert.match(PLAN_INFO.lifetime.detail,/team-service package/);});
+test('Starter now permits messaging and inventory promotions, excludes the requested four features',()=>{assert.equal(hasPlanFeature('starter','messaging'),true);assert.equal(hasPlanFeature('starter','inventory_marketing'),true);for(const feature of ['email','referrals','business_landing','chatbot'] as const)assert.equal(hasPlanFeature('starter',feature),false);});
+test('team settings cannot be opened by Pro/Starter/Free',()=>{for(const tier of PLAN_TIERS)assert.equal(canOpenSettings({...INITIAL_SETTINGS,planTier:tier},'teamServices'),tier==='max'||tier==='lifetime');});
+test('team package includes requested services with scoped, truthful deliverables',()=>{for(const id of ['advertising','leads','referrals','seo','cybersecurity'])assert.ok(TEAM_SERVICES.some(service=>service.id===id));assert.ok(TEAM_SERVICE_SCOPE.includes('not unlimited work'));assert.ok(TEAM_SERVICES.find(s=>s.id==='leads')!.deliverable.includes('consent'));assert.ok(TEAM_SERVICES.find(s=>s.id==='cybersecurity')!.deliverable.includes('approved scope'));});
+test('team controller enforces plan, role, authorization and local-draft status before saving',()=>{const text=source('src/context/POSContext.tsx');assert.ok(text.includes("requirePlanFeature(settings,'team_services')"));assert.ok(text.includes("!draft.authorized"));assert.ok(text.includes("status:'local_draft'"));assert.ok(text.includes('no team delivery, ads, lead contacts or security testing initiated'));});
+test('team UI does not pretend to send requests or spend ad money',()=>{const text=source('src/components/common/TeamServicesPanel.tsx');assert.ok(text.includes('Save local service brief'));assert.ok(text.includes('NOT been sent, queued, assigned or delivered'));assert.ok(text.includes('Do not paste passwords'));assert.ok(!text.includes("fetch('/api"));});
+test('Starter cannot use a stale callback to attribute referrals',()=>{assert.ok(source('src/context/POSContext.tsx').includes("saleData.referredBy&&!hasFeature('referrals')"));assert.ok(source('src/components/platforms/SalesPlatform.tsx').includes("hasFeature('referrals') &&"));assert.ok(source('src/components/platforms/DirectoryPlatform.tsx').includes("hasFeature('referrals') &&"));});
+test('Starter messaging omits email and records drafts, not false dispatches',()=>{const text=source('src/components/platforms/MessagingPlatform.tsx');assert.ok(text.includes("channel==='email'&&!hasFeature('email')"));assert.ok(text.includes('Message draft saved locally. Nothing has been sent.'));assert.ok(!text.includes('Michael Ouma (Customer)'));});
+
+test('referral K uses the entered invitations and conversion rate',()=>assert.equal(referralCoefficient(5,20),1));
+test('payback handles gross profit and zero denominators honestly',()=>{assert.equal(paybackMonths(100,25),4);assert.equal(paybackMonths(100,0),null);});
+test('LTV:CAC includes retention months rather than mislabelling monthly revenue as lifetime value',()=>{assert.equal(lifetimeValueRatio(40,50,12,100),2.4);assert.equal(lifetimeValueRatio(40,50,12,0),null);});
+test('optional bundle comparison and NRR use transparent ratios',()=>{assert.equal(orderValueFactor(100,120),1.2);assert.equal(orderValueFactor(0,120),null);assert.equal(netRetention(1000,100,50),1.05);assert.equal(netRetention(0,100,0),null);});
+test('weighted engagement is a planning heuristic with explicit denominator',()=>{assert.equal(weightedEngagement(10,10,10,1000),0.06);assert.equal(weightedEngagement(1,1,1,0),null);});
+test('growth planner rejects invalid assumptions rather than producing impressive garbage',()=>{assert.throws(()=>referralCoefficient(1,101));assert.throws(()=>paybackMonths(-1,2));assert.throws(()=>lifetimeValueRatio(4,Infinity,12,10));assert.throws(()=>netRetention(10,0,11));});
+const settings:AppSettings={...INITIAL_SETTINGS,regional:{timeZone:'Africa/Nairobi',dateFormat:'DD/MM/YYYY',timeFormat:'24h',holidayDates:[]}};
+const today=new Date('2026-10-20T12:00:00Z');
+const sale=(date:string,total:number)=>({timestamp:date,netTotal:total} as SaleTransaction);
+test('empty forecasting invents neither 18500 revenue, history growth nor future confidence',()=>{const result=salesProjection([],settings,today);assert.equal(result.recordedTotal,0);assert.equal(result.eligible,false);assert.equal(result.future.length,0);assert.equal(result.scenarioTotal,null);assert.ok(result.history.every(p=>p.actual===0));});
+test('future scenario requires at least three distinct transaction dates',()=>{assert.equal(salesProjection([sale('2026-10-20T12:00:00Z',100),sale('2026-10-20T13:00:00Z',200)],settings,today).eligible,false);});
+test('historical points are actual recorded sums and the average is reproducible',()=>{const result=salesProjection([sale('2026-10-18T10:00:00Z',70),sale('2026-10-19T10:00:00Z',70),sale('2026-10-20T10:00:00Z',70)],settings,today);assert.equal(result.recordedTotal,210);assert.equal(result.observedDays,3);assert.equal(result.future.length,7);assert.equal(result.future[0].forecast,30);assert.equal(result.scenarioTotal,210);});
+test('manual forecast adjustments change scenarios, not historical records',()=>{const sales=[sale('2026-10-18T10:00:00Z',70),sale('2026-10-19T10:00:00Z',70),sale('2026-10-20T10:00:00Z',70)];const base=salesProjection(sales,settings,today),lift=salesProjection(sales,settings,today,'average',10);assert.deepEqual(lift.history,base.history);assert.equal(lift.future[0].forecast,33);});
+test('invalid/future transactions do not create historical data and linear scenarios stay nonnegative',()=>{const result=salesProjection([sale('bad',9999),sale('2027-01-01T00:00:00Z',9999),sale('2026-10-18T10:00:00Z',300),sale('2026-10-19T10:00:00Z',200),sale('2026-10-20T10:00:00Z',0)],settings,today,'linear');assert.equal(result.recordedTotal,500);assert.ok(result.future.every(point=>point.forecast!>=0));});
