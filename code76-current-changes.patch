+import React, { useState } from 'react';
+import type { AppSettings } from '../../types/index.ts';
+import { regional, dateTime, validTimeZone } from '../../utils/regional.ts';
+export function RegionalSettingsForm({ settings, onChange }: { settings: AppSettings; onChange: (settings: AppSettings) => void }) {
+  const config = regional(settings);
+  const [holiday,setHoliday] = useState('');
+  const zones = [...new Set([config.timeZone,'Africa/Nairobi','UTC','Europe/London','America/New_York','Asia/Dubai',...(Intl.supportedValuesOf?.('timeZone') || [])])];
+  const update = (patch: Partial<typeof config>) => onChange({...settings,regional:{...config,...patch}});
+  const input = 'mt-1 w-full rounded-xl border border-slate-700 bg-slate-800 px-3 py-2 text-sm';
+  return <section className="space-y-4"><h2 className="font-bold text-xl">Currency, Date & Time</h2><p className="text-sm text-slate-400">Controls display preferences, not the device clock. UTC timestamps remain unchanged; date-only invoices/expenses keep their original calendar date. Changing currency does not convert historical amounts.</p><div className="grid sm:grid-cols-2 gap-4"><label className="text-xs font-semibold text-slate-400">Operating currency<input aria-label="Operating currency" maxLength={3} className={input} value={settings.payments.defaultCurrency} onChange={event=>onChange({...settings,payments:{...settings.payments,defaultCurrency:event.target.value.toUpperCase()}})}/></label><label className="text-xs font-semibold text-slate-400">Time zone<select aria-label="Time zone" className={input} value={config.timeZone} onChange={event=>{if(validTimeZone(event.target.value))update({timeZone:event.target.value});}}>{zones.map(zone=><option key={zone}>{zone}</option>)}</select></label><label className="text-xs font-semibold text-slate-400">Date format<select aria-label="Date format" className={input} value={config.dateFormat} onChange={event=>update({dateFormat:event.target.value as typeof config.dateFormat})}>{['DD/MM/YYYY','MM/DD/YYYY','YYYY-MM-DD'].map(f=><option key={f}>{f}</option>)}</select></label><label className="text-xs font-semibold text-slate-400">Time format<select aria-label="Time format" className={input} value={config.timeFormat} onChange={event=>update({timeFormat:event.target.value as typeof config.timeFormat})}><option value="24h">24 hour</option><option value="12h">12 hour (AM/PM)</option></select></label></div><p className="rounded-xl border border-teal-900 p-3 text-sm text-teal-300">Display preview: {dateTime(new Date(),settings)}</p><fieldset className="rounded-xl border border-slate-700 p-4"><legend className="px-2 font-bold">Company holiday dates</legend><p className="text-xs text-slate-400 mb-3">Holiday-only shift presets use this explicit list. No country’s holidays are guessed or automatically marked as paid leave.</p><div className="flex flex-wrap gap-2"><input aria-label="Add company holiday date" type="date" className={input+' max-w-52'} value={holiday} onChange={event=>setHoliday(event.target.value)}/><button type="button" className="rounded-xl border border-teal-700 px-3 py-2 text-sm" disabled={!holiday} onClick={()=>{update({holidayDates:[...new Set([...config.holidayDates,holiday])].sort()});setHoliday('');}}>Add holiday</button></div><div className="mt-3 flex flex-wrap gap-2">{config.holidayDates.map(date=><button key={date} type="button" aria-label={`Remove holiday ${date}`} className="rounded-lg border border-slate-700 px-2 py-1 text-xs" onClick={()=>update({holidayDates:config.holidayDates.filter(d=>d!==date)})}>{date} ×</button>)}</div></fieldset><p className="text-xs text-slate-400">Save All Settings Changes to apply. Shift times are local to the selected time zone. Rates and holiday schedules do not create payroll or expenses automatically.</p></section>;
+}
