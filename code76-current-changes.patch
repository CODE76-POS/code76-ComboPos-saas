assName="mt-1 w-full rounded-lg border border-slate-700 bg-slate-800 p-2 text-sm" value={scope} onChange={event=>setScope(event.target.value)} placeholder="Business audience, approved website/assets, budget boundaries or timing. Do not paste passwords, tokens or private customer lists."/></label><label className="block text-xs text-slate-400">Business contact (optional)<input aria-label="Service brief contact" maxLength={300} className="mt-1 w-full rounded-lg border border-slate-700 bg-slate-800 p-2 text-sm" value={contact} onChange={event=>setContact(event.target.value)}/></label><label className="block text-xs"><input aria-label="Authorized service brief" type="checkbox" checked={authorized} onChange={event=>setAuthorized(event.target.checked)} required/> I am authorized to request work for this business and understand this is a local draft—not an instruction to spend, contact leads, test systems or deliver services.</label><button type="submit" className="rounded-lg bg-teal-700 px-4 py-2 text-sm font-bold text-white">Save local service brief</button></form>{notice&&<p role="status" className="rounded-lg border border-teal-800 p-3 text-sm">{notice}</p>}<div><h3 className="font-bold">Saved local drafts</h3>{!teamServiceBriefs.length&&<p className="mt-2 text-sm text-slate-400">No drafts yet. No request has been sent.</p>}{teamServiceBriefs.map(brief=><article key={brief.id} className="mt-3 rounded-xl border border-slate-700 p-4"><h4 className="font-bold">{TEAM_SERVICES.find(s=>s.id===brief.serviceId)?.title} · {brief.businessName}</h4><p className="mt-1 text-[10px] text-amber-300">LOCAL DRAFT · Not delivered · {brief.createdAt}</p><pre tabIndex={0} className="mt-3 whitespace-pre-wrap break-words text-xs text-slate-400">{[brief.website,brief.goal,brief.scope,brief.contact].filter(Boolean).join('\n')}</pre><button type="button" className="mt-3 text-xs font-bold text-teal-400 underline" onClick={()=>copy([brief.businessName,brief.serviceId,brief.website,brief.goal,brief.scope,brief.contact].filter(Boolean).join('\n'))}>Copy service brief</button></article>)}</div></section>;
