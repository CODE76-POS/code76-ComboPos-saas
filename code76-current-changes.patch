+export const PredictiveTrendsSection:React.FC<Props>=({sales})=>{
+ const {settings,company,hasFeature,hasPrivilege}=usePOS();const [model,setModel]=useState<'average'|'linear'>('average');const [adjustment,setAdjustment]=useState(0);
+ const result=useMemo(()=>salesProjection(sales,settings,new Date(),model,adjustment),[sales,settings.regional,model,adjustment]);
+ const money=(n:number)=>`${company.currency||settings.payments.defaultCurrency} ${n.toLocaleString(undefined,{maximumFractionDigits:2})}`;
+ const exportCsv=()=>{if(!hasFeature('data_export')||!hasPrivilege('canExportPdf'))return;exportToCSV(result.points.map(point=>({Date:point.date,Type:point.kind==='recorded'?'Recorded net sales':'Scenario estimate, not guaranteed',RecordedNetSales:point.actual??'',Scenario:point.forecast??'',Currency:company.currency,Method:model,AdjustmentPercent:adjustment})),'CODE76-recorded-sales-and-scenario');};
+ return <section aria-label="Historical live and future scenario analytics" className="my-6 rounded-2xl border border-teal-800 bg-slate-900 p-4 sm:p-6"><div className="flex flex-wrap items-start justify-between gap-4"><div><span className="text-xs font-bold uppercase tracking-widest text-teal-400">Historical · live workspace · future scenarios</span><h2 className="mt-2 text-xl sm:text-2xl font-black">Read the past. Model the next step.</h2><p className="mt-3 max-w-3xl text-xs leading-relaxed text-slate-400">Historical points sum your stored net sales by the selected business timezone. Live means this view updates when workspace entries change—not a connected external market feed. Net sales can include credit sales; they are not cash collected.</p></div>{hasFeature('data_export')&&hasPrivilege('canExportPdf')&&<button onClick={exportCsv} className="rounded-lg border border-teal-700 px-3 py-2 text-xs font-bold text-teal-300">Export scenario CSV</button>}</div><div className="mt-5 grid sm:grid-cols-3 gap-3"><div className="rounded-xl border border-slate-700 p-4"><p className="text-xs text-slate-400">Recorded net sales · last 14 days</p><strong className="mt-2 block text-xl">{money(result.recordedTotal)}</strong></div><div className="rounded-xl border border-slate-700 p-4"><p className="text-xs text-slate-400">Days with recorded transactions</p><strong className="mt-2 block text-xl">{result.observedDays}</strong></div><div className="rounded-xl border border-slate-700 p-4"><p className="text-xs text-slate-400">Next 7 days · scenario estimate</p><strong className="mt-2 block text-xl text-teal-400">{result.scenarioTotal===null?'Not enough history':money(result.scenarioTotal)}</strong></div></div><div className="mt-5 grid sm:grid-cols-2 gap-4"><label className="text-xs text-slate-400">Scenario method<select aria-label="Sales scenario method" className="mt-1 w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm" value={model} onChange={event=>setModel(event.target.value as typeof model)}><option value="average">Trailing 7-day average</option><option value="linear">Simple 14-day linear trend</option></select></label><label className="text-xs text-slate-400">Your scenario adjustment (%)<input aria-label="Sales scenario adjustment" type="number" min="-90" max="200" className="mt-1 w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm" value={adjustment} onChange={event=>setAdjustment(Math.max(-90,Math.min(200,Number(event.target.value)||0)))}/></label></div>{!result.eligible&&<p role="status" className="mt-4 rounded-xl border border-amber-800 p-3 text-xs text-amber-300">Record transactions on at least 3 separate business dates within the last 14 days to enable a future scenario. No revenue, history or forecast is invented for an empty workspace.</p>}<div className="mt-6 h-72 min-w-0" role="img" aria-label="Recorded daily net sales and clearly separated future scenario line"><ResponsiveContainer width="100%" height="100%"><ComposedChart data={result.points} margin={{left:0,right:12,top:12,bottom:12}}><CartesianGrid stroke="#334155" strokeDasharray="3 3"/><XAxis dataKey="date" tick={{fontSize:10,fill:'#94a3b8'}} minTickGap={32}/><YAxis tick={{fontSize:10,fill:'#94a3b8'}} width={56}/><Tooltip contentStyle={{background:'#0f172a',border:'1px solid #334155',borderRadius:10}}/><Legend/><Line type="linear" dataKey="actual" name="Recorded net sales" stroke="#38bdf8" strokeWidth={2} dot={false} isAnimationActive={false}/><Line type="linear" dataKey="forecast" name="Future scenario (estimate)" stroke="#2dd4bf" strokeWidth={2} strokeDasharray="6 4" dot={false} isAnimationActive={false}/></ComposedChart></ResponsiveContainer></div><p className="mt-4 text-[11px] leading-relaxed text-slate-500">Methods are simple arithmetic scenarios, not Gemini/ARIMA/Prophet inference or statistically validated confidence intervals. Zero means no sales are recorded for that day; missing/offline records may make the data incomplete. Seasonality, marketing effects and profit are not predicted. Your adjustment is a chosen assumption, not a measured effect. Outcomes can differ substantially; no sales/profit guarantee is made.</p></section>;
 };
