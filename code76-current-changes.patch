+ return <section className="space-y-5"><div><h2 className="font-bold text-xl">App plans — demo entitlements</h2><p className="mt-2 text-sm text-amber-300">Displayed prices are USD offers, not a charge. There is no connected billing provider, renewal or verified paid licence. Only an administrator can change this demo workspace plan; records are retained.</p></div><div className="grid sm:grid-cols-2 gap-3">{PLAN_TIERS.map(tier=><div key={tier} data-demo-plan-card={tier} className={`rounded-xl border p-4 ${selected===tier?'border-teal-500 bg-teal-950/30':'border-slate-700'}`}><h3 className="text-lg font-bold">{PLAN_INFO[tier].name}</h3><PlanPrice tier={tier}/><p className="text-sm text-slate-400">{PLAN_INFO[tier].detail}</p><ul className="my-3 space-y-2 text-xs text-slate-400">{PLAN_INFO[tier].benefits.map(item=><li key={item}>✓ {item}</li>)}</ul><button type="button" aria-label={`Select ${PLAN_INFO[tier].name} demo plan`} disabled={!currentUser?.isAdmin||selected===tier} className="rounded-lg bg-teal-700 px-3 py-2 text-xs text-white disabled:opacity-40" onClick={()=>{try{setDemoPlan(tier);setNotice(`${PLAN_INFO[tier].name} demo plan applied. No charge; existing data retained.`);}catch(error){setNotice(String(error));}}}>{selected===tier?'Current plan':`Preview ${PLAN_INFO[tier].name}`}</button></div>)}</div>{!currentUser?.isAdmin&&<p className="text-xs text-slate-400">Only an administrator can change the demo plan.</p>}{notice&&<p role="status" className="text-sm text-teal-300">{notice}</p>}<div className="rounded-xl border border-slate-700 p-4"><label className="text-sm font-semibold">Illustrative months<input aria-label="Plan comparison months" type="number" min="1" max="120" value={months} onChange={event=>setMonths(Math.min(120,Math.max(1,Math.trunc(Number(event.target.value)||1))))} className="ml-3 w-20 rounded-lg border border-slate-700 bg-slate-800 px-2 py-1"/></label><p className="mt-2 text-xs text-slate-400">For {months} month{months===1?'':'s'} at today's 